# --- copy to .env next to docker-compose.yml and fill in ---
# MongoDB Atlas connection string (SRV form)
MONGO_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/pts?retryWrites=true&w=majority

# Public site URL (use http://YOUR_VPS_IP for first boot, then https://YOUR_DOMAIN)
APP_BASE_URL=http://YOUR_VPS_IP
# Comma-separated allowed web origins (must include APP_BASE_URL)
CORS_ORIGINS=http://YOUR_VPS_IP
LOG_LEVEL=info

# --- P1 Identity ---
# Generate with: cd backend && npm run generate:keys
JWT_PRIVATE_KEY_B64=
JWT_PUBLIC_KEY_B64=
# openssl rand -hex 24
OTP_PEPPER=
SMS_PROVIDER=console
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
MAIL_PROVIDER=console
SMTP_URL=
MAIL_FROM=RIDGELINE CAPITAL <no-reply@YOUR_DOMAIN>

# --- P2 KYC + Admin ---
# openssl rand -hex 32
DATA_ENC_SECRET=
# Encrypted KYC document root (mapped to a persistent volume in compose)
STORAGE_DIR=/app/data

# --- P3 Plans & Payments ---
PAYMENT_PROVIDER=manual
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# --- P4 Market Data ---
# Prefer Admin → provider pages for live tokens; boot fallbacks below
MARKET_FEED=simulator
UPSTOX_ACCESS_TOKEN=
UPSTOX_API_KEY=
UPSTOX_API_SECRET=
DHAN_CLIENT_ID=
DHAN_ACCESS_TOKEN=

# --- Frontend (trader) build args ---
# Leave empty for same-origin deploy (nginx serves UI + /api + /ws).
# Set only if the UI is hosted on a different public host than the API.
NEXT_PUBLIC_API_ORIGIN=
NEXT_PUBLIC_WS_URL=
