# --- copy to .env next to docker-compose.yml and fill in ---
# MongoDB Atlas connection string (SRV form)
MONGO_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/pts?retryWrites=true&w=majority
# Comma-separated allowed web origins
CORS_ORIGINS=https://YOUR_DOMAIN
LOG_LEVEL=info

# --- P1 Identity ---
APP_BASE_URL=https://YOUR_DOMAIN
# Generate with: cd backend && npm run generate:keys
JWT_PRIVATE_KEY_B64=
JWT_PUBLIC_KEY_B64=
# openssl rand -hex 24
OTP_PEPPER=
SMS_PROVIDER=msg91
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
MAIL_PROVIDER=smtp
SMTP_URL=smtps://user:pass@smtp.yourprovider.com:465
MAIL_FROM=RIDGELINE CAPITAL <no-reply@YOUR_DOMAIN>

# --- P2 KYC + Admin ---
# openssl rand -hex 32
DATA_ENC_SECRET=
# Encrypted KYC document root (mapped to a persistent volume in compose)
STORAGE_DIR=/app/data

# --- P3 Plans & Payments ---
PAYMENT_PROVIDER=razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# --- P4 Market Data ---
# Optional boot fallbacks — prefer Admin → Upstox API for live setup
MARKET_FEED=simulator
UPSTOX_ACCESS_TOKEN=
UPSTOX_API_KEY=
UPSTOX_API_SECRET=

# --- Frontend (trader) — also set in frontend/trader/.env.local ---
# NEXT_PUBLIC_API_ORIGIN=http://localhost:4000
# NEXT_PUBLIC_WS_URL=ws://localhost:4100/ws
