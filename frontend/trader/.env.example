# Copy to .env.local for local Next.js
#
# --- TradingView chart environment (this repo) ---
# Uses TradingView *Lightweight Charts* (npm package, no license file) plus a
# TradingView-shaped DataFeed adapter in src/lib/market/datafeed.ts.
# It does NOT use the commercial TradingView Charting Library (charting_library/
# widget bundle). To swap in Advanced Charts later, drop the licensed bundle
# under public/charting_library/ and wire a Widget wrapper to UpstoxDataFeed.
#
# Required for /watchlist chart + live quotes:
NEXT_PUBLIC_API_ORIGIN=http://localhost:4000
# Live-quote WebSocket. Leave UNSET when the app is reached through a single
# proxied/forwarded web port (e.g. a cloud dev host): the datafeed then uses a
# same-origin ws://<host>/ws, which next.config.mjs proxies to the engine, so
# the browser only needs the web port. Set it explicitly only for pure-local
# dev where the browser can reach the engine directly:
#   NEXT_PUBLIC_WS_URL=ws://localhost:4100/ws

# Start backend before the trader UI:
#   cd backend && npm run start:api:dev    # :4000  REST + /api/v1/market/candles
#   cd backend && npm run start:engine:dev # :4100  live quotes + chart ticks (/ws)
# One-shot bootstrap (config, starter instruments, dev trader):
#   cd backend && npm run bootstrap:dev
# Dev trader: trader@test.local / TestPass123!
# Live feed: set MARKET_FEED + provider tokens in backend/.env (see backend/.env.example)
# UI dev server (matches backend CORS): npm run dev  → http://localhost:3075
