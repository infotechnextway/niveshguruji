# Local API dev — copy to backend/.env and fill in.
# Generate keys: npm run generate:keys
# One-shot bootstrap (config + instruments if empty + dev trader):
#   npm run bootstrap:dev
# Seed admin (first run only):
#   ADMIN_EMAIL=admin@ridgeline.local ADMIN_PASSWORD=AdminPass1234! npm run seed:admin
# Default dev credentials after seeding: admin@ridgeline.local / AdminPass1234!
# Dev trader (after bootstrap:dev): trader@test.local / TestPass123!

NODE_ENV=development
API_PORT=4000
MONGO_URI=mongodb://127.0.0.1:27017/pts
REDIS_URL=redis://127.0.0.1:6379
CORS_ORIGINS=http://localhost:3075,http://localhost:3000
APP_BASE_URL=http://localhost:3075
LOG_LEVEL=info

JWT_PRIVATE_KEY_B64=
JWT_PUBLIC_KEY_B64=
OTP_PEPPER=local-dev-otp-pepper-0123456789ab
DATA_ENC_SECRET=local-dev-data-enc-secret-0123456789
STORAGE_DIR=./data

# --- Market data (boot defaults; Admin panel can override in Mongo) ---
# simulator = synthetic ticks (no credentials). upstox | dhan | angel = live feeds.
MARKET_FEED=simulator

# Upstox (when MARKET_FEED=upstox) — also used for historical candles
UPSTOX_ACCESS_TOKEN=
UPSTOX_API_KEY=
UPSTOX_API_SECRET=

# Dhan (when MARKET_FEED=dhan)
DHAN_CLIENT_ID=
DHAN_ACCESS_TOKEN=

# Angel One (when MARKET_FEED=angel)
ANGEL_API_KEY=
ANGEL_CLIENT_CODE=
ANGEL_JWT_TOKEN=
ANGEL_FEED_TOKEN=

# Full instrument master (optional; bootstrap:dev seeds a starter set if empty):
# npm run sync:instruments

# Dev trader bootstrap overrides (optional):
# TRADER_EMAIL=trader@test.local
# TRADER_PASSWORD=TestPass123!
